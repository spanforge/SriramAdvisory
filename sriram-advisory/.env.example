# Public site configuration
NEXT_PUBLIC_BASE_URL=https://www.sriramadvisory.com

# Enable only if the existing Vercel plan already includes custom events.
# No analytics subscription or upgrade is required by this release.
NEXT_PUBLIC_REVIEW_ANALYTICS=0
# Set to 1 for hosted staging. Configure server-only access credentials below.
SRIRAM_STAGING=0
STAGING_USERNAME=
STAGING_PASSWORD=

# Cashfree integration. Use sandbox values outside production.
CASHFREE_APP_ID=replace_me
CASHFREE_SECRET_KEY=replace_me
CASHFREE_ENV=sandbox
NEXT_PUBLIC_CASHFREE_ENV=sandbox

